<?xml version="1.0" encoding="UTF-8"?>
<SP241 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <Header>
        <Myndighed>urn:oio:cvr-nr:12345678</Myndighed>
        <ModtagetDato>2026-04-24</ModtagetDato>
        <KLE>{{ handler.settings.distributionContext.kleEmne }}</KLE>
        <!-- {% for file in files.dokumenter_overslag|default([]) %} -->
